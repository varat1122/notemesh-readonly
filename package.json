{
  "name": "notemesh",
  "version": "1.3.0",
  "description": "Personal Obsidian vault MCP server — Railway template",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "postinstall": "node scripts/patch-oauth-refresh-scopes.mjs",
    "dev": "vinxi dev",
    "build": "vinxi build && node scripts/build-price-job.mjs && node scripts/check-client-bundle.mjs && node scripts/check-runtime-exclusions.mjs",
    "check:client": "node scripts/check-client-bundle.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "start": "vinxi start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e scripts --max-warnings 0",
    "lint:fix": "eslint src tests e2e scripts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "snapshot:coverage:offline": "node --experimental-strip-types scripts/audit-vault-snapshot.mjs",
    "snapshot:sources:offline": "node --experimental-strip-types scripts/audit-vault-snapshot.mjs --sources",
    "snapshot:review:offline": "node --experimental-strip-types scripts/audit-vault-snapshot.mjs --review",
    "prices:status": "node scripts/market-prices.ts status",
    "prices:refresh": "node scripts/market-prices.ts refresh"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@picocss/pico": "^2.1.1",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "@solidjs/start": "^1.3.2",
    "better-auth": "1.7.7",
    "better-sqlite3": "^13.0.2",
    "chokidar": "^5.0.0",
    "execa": "^10.0.0",
    "fetch-to-node": "^2.1.0",
    "jose": "^6.2.4",
    "obsidian-headless": "0.0.14",
    "solid-js": "^1.9.7",
    "vinxi": "^0.5.11",
    "yaml": "2.9.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.9.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "author": "ChangeNode (Will Iverson) <https://changenode.com/>",
  "license": "AGPL-3.0-or-later"
}
