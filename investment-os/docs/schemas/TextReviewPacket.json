{
  "$defs": {
    "TextReviewItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "contains_number": {
          "title": "Contains Number",
          "type": "boolean"
        },
        "status": {
          "const": "needs_human_review",
          "default": "needs_human_review",
          "title": "Status",
          "type": "string"
        },
        "untrusted_data": {
          "const": true,
          "default": true,
          "title": "Untrusted Data",
          "type": "boolean"
        },
        "independent_evidence": {
          "const": false,
          "default": false,
          "title": "Independent Evidence",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "char_start",
        "char_end",
        "line_start",
        "line_end",
        "text",
        "text_sha256",
        "contains_number"
      ],
      "title": "TextReviewItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "synthetic-paragraph-review-v1",
      "default": "synthetic-paragraph-review-v1",
      "title": "Algorithm",
      "type": "string"
    },
    "scope": {
      "const": "synthetic_local_review_draft",
      "default": "synthetic_local_review_draft",
      "title": "Scope",
      "type": "string"
    },
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "document_version": {
      "minimum": 1,
      "title": "Document Version",
      "type": "integer"
    },
    "document_payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Document Payload Sha256",
      "type": "string"
    },
    "source_id": {
      "format": "uuid",
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "minimum": 1,
      "title": "Source Version",
      "type": "integer"
    },
    "source_payload_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Payload Sha256",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/TextReviewItem"
      },
      "maxItems": 200,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "status": {
      "const": "needs_human_review",
      "default": "needs_human_review",
      "title": "Status",
      "type": "string"
    },
    "output_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Sha256",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "document_version",
    "document_payload_sha256",
    "source_id",
    "source_version",
    "source_payload_sha256",
    "source_sha256",
    "items",
    "output_sha256"
  ],
  "title": "TextReviewPacket",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-os:schema:1.0:TextReviewPacket"
}
