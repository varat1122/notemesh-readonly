{
  "$defs": {
    "Classification": {
      "enum": [
        "public",
        "licensed_vendor",
        "internal_research",
        "confidential_portfolio",
        "personal_sensitive",
        "secret"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "source",
            "human",
            "ai",
            "deterministic",
            "system",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "basis": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "original_origin_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Origin Id"
        },
        "independent_evidence": {
          "default": false,
          "title": "Independent Evidence",
          "type": "boolean"
        },
        "license_id": {
          "default": "synthetic-only",
          "maxLength": 10000,
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "permitted_uses": {
          "default": [
            "local_research"
          ],
          "items": {
            "enum": [
              "local_research",
              "model_input",
              "redistribute"
            ],
            "type": "string"
          },
          "title": "Permitted Uses",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "basis",
        "actor_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SymbolAlias": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "venue": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Venue",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        }
      },
      "required": [
        "symbol",
        "venue",
        "currency",
        "valid_from"
      ],
      "title": "SymbolAlias",
      "type": "object"
    },
    "Times": {
      "additionalProperties": false,
      "properties": {
        "event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event At"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        },
        "data_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data As Of"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "calculation_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation At"
        },
        "known_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known At"
        },
        "available_to_strategy_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available To Strategy At"
        },
        "vintage_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vintage At"
        }
      },
      "required": [
        "received_at",
        "imported_at"
      ],
      "title": "Times",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "times": {
      "$ref": "#/$defs/Times"
    },
    "classification": {
      "$ref": "#/$defs/Classification",
      "default": "internal_research"
    },
    "verification": {
      "default": "unverified",
      "enum": [
        "unverified",
        "verified",
        "rejected",
        "superseded",
        "not_applicable"
      ],
      "title": "Verification",
      "type": "string"
    },
    "verified_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified By"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "kind": {
      "const": "instrument",
      "default": "instrument",
      "title": "Kind",
      "type": "string"
    },
    "issuer_id": {
      "format": "uuid",
      "title": "Issuer Id",
      "type": "string"
    },
    "asset_type": {
      "enum": [
        "equity",
        "bond",
        "fund",
        "fx",
        "commodity",
        "derivative"
      ],
      "title": "Asset Type",
      "type": "string"
    },
    "share_class": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Share Class",
      "type": "string"
    },
    "aliases": {
      "items": {
        "$ref": "#/$defs/SymbolAlias"
      },
      "minItems": 1,
      "title": "Aliases",
      "type": "array"
    },
    "external_ids": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "External Ids",
      "type": "object"
    }
  },
  "required": [
    "id",
    "provenance",
    "times",
    "issuer_id",
    "asset_type",
    "share_class",
    "aliases"
  ],
  "title": "Instrument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-os:schema:1.0:Instrument"
}
