{
  "$defs": {
    "Classification": {
      "enum": [
        "public",
        "licensed_vendor",
        "internal_research",
        "confidential_portfolio",
        "personal_sensitive",
        "secret"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "enum": [
            "source",
            "human",
            "ai",
            "deterministic",
            "system",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "basis": {
          "maxLength": 10000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "original_origin_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Origin Id"
        },
        "independent_evidence": {
          "default": false,
          "title": "Independent Evidence",
          "type": "boolean"
        },
        "license_id": {
          "default": "synthetic-only",
          "maxLength": 10000,
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "permitted_uses": {
          "default": [
            "local_research"
          ],
          "items": {
            "enum": [
              "local_research",
              "model_input",
              "redistribute"
            ],
            "type": "string"
          },
          "title": "Permitted Uses",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "basis",
        "actor_id"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Times": {
      "additionalProperties": false,
      "properties": {
        "event_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event At"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "verified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified At"
        },
        "data_as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data As Of"
        },
        "effective_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective From"
        },
        "effective_to": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective To"
        },
        "calculation_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation At"
        },
        "known_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known At"
        },
        "available_to_strategy_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available To Strategy At"
        },
        "vintage_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vintage At"
        }
      },
      "required": [
        "received_at",
        "imported_at"
      ],
      "title": "Times",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "times": {
      "$ref": "#/$defs/Times"
    },
    "classification": {
      "$ref": "#/$defs/Classification",
      "default": "internal_research"
    },
    "verification": {
      "default": "unverified",
      "enum": [
        "unverified",
        "verified",
        "rejected",
        "superseded",
        "not_applicable"
      ],
      "title": "Verification",
      "type": "string"
    },
    "verified_by": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified By"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "kind": {
      "const": "event",
      "default": "event",
      "title": "Kind",
      "type": "string"
    },
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "event_type": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "period": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Period",
      "type": "string"
    },
    "classification_result": {
      "default": "unresolved",
      "enum": [
        "new_event",
        "duplicate",
        "added_detail",
        "correction",
        "contradiction",
        "confirmation",
        "unresolved",
        "thesis_changing_candidate"
      ],
      "title": "Classification Result",
      "type": "string"
    },
    "related_event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Event Id"
    }
  },
  "required": [
    "id",
    "provenance",
    "times",
    "company_id",
    "source_ids",
    "event_type",
    "period"
  ],
  "title": "Event",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-os:schema:1.0:Event"
}
