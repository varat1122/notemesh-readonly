{
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "xlsx",
      "default": "xlsx",
      "title": "Kind",
      "type": "string"
    },
    "sheet": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Sheet",
      "type": "string"
    },
    "cell": {
      "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,4}$",
      "title": "Cell",
      "type": "string"
    },
    "style_index": {
      "default": 0,
      "minimum": 0,
      "title": "Style Index",
      "type": "integer"
    }
  },
  "required": [
    "sheet",
    "cell"
  ],
  "title": "XlsxLocator",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-os:schema:1.0:XlsxLocator"
}
