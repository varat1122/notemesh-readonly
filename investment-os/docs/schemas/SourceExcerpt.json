{
  "$defs": {
    "CsvLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "csv",
          "default": "csv",
          "title": "Kind",
          "type": "string"
        },
        "record": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Record",
          "type": "integer"
        },
        "column": {
          "maximum": 100,
          "minimum": 1,
          "title": "Column",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        }
      },
      "required": [
        "record",
        "column",
        "line_start",
        "line_end"
      ],
      "title": "CsvLocator",
      "type": "object"
    },
    "PdfLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pdf",
          "default": "pdf",
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "maximum": 100,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "char_start": {
          "minimum": 0,
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "exclusiveMinimum": 0,
          "title": "Char End",
          "type": "integer"
        }
      },
      "required": [
        "page",
        "char_start",
        "char_end"
      ],
      "title": "PdfLocator",
      "type": "object"
    },
    "XlsxLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "xlsx",
          "default": "xlsx",
          "title": "Kind",
          "type": "string"
        },
        "sheet": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sheet",
          "type": "string"
        },
        "cell": {
          "pattern": "^[A-Z]{1,2}[1-9][0-9]{0,4}$",
          "title": "Cell",
          "type": "string"
        },
        "style_index": {
          "default": 0,
          "minimum": 0,
          "title": "Style Index",
          "type": "integer"
        }
      },
      "required": [
        "sheet",
        "cell"
      ],
      "title": "XlsxLocator",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "locator": {
      "discriminator": {
        "mapping": {
          "csv": "#/$defs/CsvLocator",
          "pdf": "#/$defs/PdfLocator",
          "xlsx": "#/$defs/XlsxLocator"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PdfLocator"
        },
        {
          "$ref": "#/$defs/CsvLocator"
        },
        {
          "$ref": "#/$defs/XlsxLocator"
        }
      ],
      "title": "Locator"
    },
    "text": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "value_type": {
      "default": "text",
      "enum": [
        "text",
        "number",
        "boolean",
        "date_lexical",
        "error"
      ],
      "title": "Value Type",
      "type": "string"
    },
    "text_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Text Sha256",
      "type": "string"
    },
    "untrusted_data": {
      "const": true,
      "default": true,
      "title": "Untrusted Data",
      "type": "boolean"
    },
    "independent_evidence": {
      "const": false,
      "default": false,
      "title": "Independent Evidence",
      "type": "boolean"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    }
  },
  "required": [
    "locator",
    "text",
    "text_sha256",
    "id"
  ],
  "title": "SourceExcerpt",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:investment-os:schema:1.0:SourceExcerpt"
}
